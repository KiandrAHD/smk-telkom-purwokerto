# .htaccess for SPA + optimal asset cache (JHIC)

# 1. Main SPA HTML: never cache, always revalidate
<IfModule mod_headers.c>
  <FilesMatch "^(index|app)\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# 2. Static asset hashes: cache forever
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|webp|avif|png|jpe?g|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 3. SPA fallback (client-side routing)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/assets/
RewriteRule ^ app.html [L]
</IfModule>
