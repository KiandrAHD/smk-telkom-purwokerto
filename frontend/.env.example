# ============================================================
# Kunci AI — isi SALAH SATU saja.
# Urutan prioritas bila lebih dari satu terisi: Anthropic, Gemini, Groq.
# ============================================================
# PENTING: semua kunci di bawah TANPA awalan VITE_. Awalan itu
# membuat Vite menyuntikkan nilainya ke bundel browser, dan kunci
# Anda bisa dibaca siapa pun lewat DevTools. Semuanya hanya dibaca
# proses Node dev server (vite-plugin-stela.js), tidak pernah
# menyeberang ke sisi klien.

# Groq — https://console.groq.com/keys   (bentuk: gsk_ + 52 karakter)
# Tercepat, tapi tier gratisnya hanya 8.000 token PER MENIT. STELA otomatis
# memangkas pengetahuannya ke ~3.000 token agar muat; praktisnya sekitar
# 1-2 pertanyaan per menit. Untuk situs ramai, pakai Gemini.
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Bentuknya diawali "AIzaSy" dan panjangnya 39 karakter.
GEMINI_API_KEY=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opsional. Bawaan: claude-opus-5 / gemini-3.6-flash / openai/gpt-oss-20b.
STELA_MODEL=

# ============================================================
# Pagar biaya
# ============================================================
# Sakelar mati darurat. Isi "false" untuk membungkam STELA seketika.
STELA_AKTIF=

# Plafon panggilan berbayar per hari. Jawaban dari cache tidak
# memakan jatah ini. Bawaan: 100 (lokal) / 500 (Edge Function).
STELA_MAKS_PER_HARI=

# Plafon per alamat IP tiap 5 menit. Bawaan 20.
STELA_MAKS_PER_IP=

# ============================================================
# Supabase (produksi: Edge Function, PPDB, dashboard admin)
# ============================================================
# Anon key, BUKAN service_role / sb_secret_. Anon key aman di browser
# karena dibatasi RLS; service key melewati RLS dan tidak boleh keluar
# dari server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
