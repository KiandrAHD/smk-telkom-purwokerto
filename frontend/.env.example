# Public URL of the separately deployed Express/MySQL backend.
# Required for production preview; localhost is development-only.
VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=https://smk-telkom-purwokerto.vercel.app
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=false
# Build-time prerender mode: strict (default, aborts if backend unreachable) or resilient (Vercel-safe).
# PRERENDER_MODE=resilient
# Supabase database/auth variables are NOT used by the application.
# Operational database is MySQL via the Express backend above.
# Supabase Storage is used only by the backend for encrypted backups.
