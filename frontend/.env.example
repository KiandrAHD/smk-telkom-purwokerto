# Public URL of the separately deployed Express/MySQL backend.
# Required for Vercel Preview and Production; localhost is development-only.
VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=https://smk-telkom-purwokerto.vercel.app
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=false
# Build-time prerender mode: strict (default, aborts if backend unreachable) or resilient (Vercel-safe).
# PRERENDER_MODE=resilient
# Supabase variables are no longer used by the application.
