# --- STELA: mode lokal (paling cepat, tanpa Supabase) ---
# Kunci Anthropic. TANPA awalan VITE_ -- awalan itu membuat Vite menyuntikkan
# nilainya ke bundel browser, dan kunci Anda bocor ke siapa pun yang membuka
# DevTools. Dibaca hanya oleh vite-plugin-stela.js di proses Node dev server.
ANTHROPIC_API_KEY=

# Opsional. Bawaannya claude-opus-5.
STELA_MODEL=

# --- Supabase (produksi: Edge Function, PPDB, dashboard admin) ---
# Anon key, BUKAN service_role / sb_secret_. Anon key aman di browser karena
# dibatasi RLS; service key melewati RLS dan tidak boleh keluar dari server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
