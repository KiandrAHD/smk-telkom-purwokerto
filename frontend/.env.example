# ============================================================
# Frontend environment variables (safe for browser)
# VITE_ prefix makes these available to client-side code.
# These are PUBLIC keys subject to RLS - never put secrets here.
# ============================================================

# Supabase (required for production features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (anti-bot on admin login)
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=false

# ============================================================
# SERVER-SIDE SECRETS (set via Supabase Edge Function secrets)
# ============================================================
# Do NOT put these in this file. Set them using:
#   npx supabase secrets set GEMINI_API_KEY=your_key
#   npx supabase secrets set NINEROUTER_KEY=your_key
#   npx supabase secrets set CF_TURNSTILE_SECRET=your_key
#
# Local development: use frontend/.env.local (gitignored)
# for server-side keys read by vite-plugin-stela.js
# ============================================================

# ============================================================
# LOCAL DEVELOPMENT ONLY (create .env.local for these)
# ============================================================
# For local STELA development, create frontend/.env.local with:
# GEMINI_API_KEY=your_key
# NINEROUTER_KEY=your_key
# NINEROUTER_URL=http://127.0.0.1:20128
# NINEROUTER_MODEL=kr/claude-haiku-4.5
#
# DO NOT commit .env.local - it's gitignored
# ============================================================
