NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://smk_app:PASSWORD@127.0.0.1:3306/smk_telkom_purwokerto
# Supabase PostgreSQL lama — sumber arsip ETL satu kali. Bukan database operasional.
SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key hanya untuk backup/restore/ETL server-side. Jangan pernah expose ke frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BACKUP_BUCKET=mysql-backups
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=generate-a-random-secret-at-least-32-characters

# Optional connection tuning
DB_CONNECTION_LIMIT=10

# SMTP (email verification / password reset). Leave empty to log links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@smktelkom-pwt.sch.id
PUBLIC_URL=http://localhost:5173

# Cloudflare Turnstile
CF_TURNSTILE_SECRET=
TURNSTILE_ALLOWED_ORIGINS=http://localhost:5173

# Persistent local/VPS upload storage. Use an absolute path in production.
UPLOAD_ROOT=./uploads
# Public backend URL used in stored media URLs (never a Supabase database URL).
MEDIA_BASE_URL=http://localhost:3000
# Optional public object-storage base URL if uploads are served elsewhere.
PUBLIC_STORAGE_URL=

# Encrypted MySQL backup. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
# Path absolut mysqldump/mysql — wajib pada Windows (Laragon) dan VPS.
MYSQLDUMP_PATH=D:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqldump.exe
MYSQL_PATH=D:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysql.exe
BACKUP_SCHEDULE=0 2 * * *

# Account recovery (one-time admin bootstrap). Generate a strong password, set these env vars,
# run `npm run db:seed`, then REMOVE these from .env and change the password from the admin UI.
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD=
ADMIN_RECOVERY_NAME=Administrator Pemulihan

# AI STELA / NextTel
STELA_MAKS_PER_HARI=200
NEXTTEL_MAKS_PER_HARI=100
STELA_MAKS_PER_IP=5
NEXTTEL_MAKS_PER_IP=10
STELA_AKTIF=false
STELA_API_KEY=
GEMINI_API_KEY=
STELA_PROVIDER_URL=
