NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://smk_app:PASSWORD@127.0.0.1:3306/smk_telkom_purwokerto
SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=generate-a-random-secret-at-least-32-characters

# Optional connection tuning
DB_CONNECTION_LIMIT=10

# SMTP (email verification / password reset). Leave empty to log links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@smktelkom-pwt.sch.id
PUBLIC_URL=http://localhost:5173

# Cloudflare Turnstile
CF_TURNSTILE_SECRET=
TURNSTILE_ALLOWED_ORIGINS=http://localhost:5173

# Local upload storage
UPLOAD_ROOT=
# Production public storage base URL (object storage / static host). Leave unset to use /storage.
PUBLIC_STORAGE_URL=

# AI STELA / NextTel
STELA_MAKS_PER_HARI=200
NEXTTEL_MAKS_PER_HARI=100
STELA_MAKS_PER_IP=5
NEXTTEL_MAKS_PER_IP=10
STELA_AKTIF=false
STELA_API_KEY=
GEMINI_API_KEY=
STELA_PROVIDER_URL=
